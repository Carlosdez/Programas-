<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QR Acceso Casas XVI Guest</title>
  <style>
    body { font-family: system-ui, Arial; padding:20px; max-width:900px; margin:auto; text-align:center; }
    h1 { font-size:1.6rem; margin-bottom:0.5rem; }
    .section { border:1px solid #ddd; border-radius:10px; padding:20px; margin-top:20px; }
    #qrcodeWifi, #qrcodePortal { margin-top:14px; display:flex; justify-content:center; }
  </style>
</head>
<body>
  <h1>Acceso Wi-Fi — Casas XVI Guest</h1>
  <p>Escanea uno de los siguientes QR para conectarte:</p>

  <div class="section">
    <h2>1️⃣ Conexión Wi-Fi Automática</h2>
    <p>SSID: <b>Casas XVI Guest</b><br>
       Usuario: <b>casasxvi@2025</b><br>
       Contraseña: <b>12345</b></p>
    <div id="qrcodeWifi"></div>
    <small>El QR incluye la configuración de red con usuario y contraseña.<br>
    Nota: no todos los teléfonos soportan WPA2-Enterprise por QR.</small>
  </div>

  <div class="section">
    <h2>2️⃣ Portal de Acceso</h2>
    <p>Escanea para abrir la página de login:</p>
    <div id="qrcodePortal"></div>
    <p><a href="http://172.16.172.1">http://172.16.172.1</a></p>
  </div>

  <!-- Librería QRCode -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script>
    // Generar QR para Wi-Fi WPA2 Enterprise
    const wifiPayload = "WIFI:T:WPA2-EAP;S:Casas XVI Guest;E:TTLS;U:casasxvi@2025;P:12345;;";
    new QRCode(document.getElementById("qrcodeWifi"), {
      text: wifiPayload,
      width: 220,
      height: 220,
      correctLevel: QRCode.CorrectLevel.H
    });

    // Generar QR para portal de login
    new QRCode(document.getElementById("qrcodePortal"), {
      text: "http://172.16.172.1",
      width: 220,
      height: 220,
      correctLevel: QRCode.CorrectLevel.H
    });
  </script>
</body>
</html>
